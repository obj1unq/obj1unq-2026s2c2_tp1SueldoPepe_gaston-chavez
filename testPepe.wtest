import pepe.*

describe "Sueldo Pepe" {
	
	test "Test 1 Primera parte sueldo pepe" {
		pepe.cambiarCategoria(cadete)
		pepe.cambiarBonoR(bonoMontoFijo)
		pepe.cambiarBonoP(bonoPresentismoNormal)
		pepe.cambiarCantidadDeFaltas(3)
		assert.equals(20800, pepe.sueldo())

		pepe.cambiarCategoria(gerente)
		pepe.cambiarBonoR(bonoPorcentaje)
		pepe.cambiarBonoP(bonoNulo)
		assert.equals(16500, pepe.sueldo())

		pepe.cambiarCategoria(cadete)
		pepe.cambiarBonoR(bonoPorcentaje)
		pepe.cambiarBonoP(bonoPresentismoNormal)
		pepe.cambiarCantidadDeFaltas(0)
		assert.equals(24000, pepe.sueldo())

		pepe.cambiarCategoria(cadete)
		pepe.cambiarBonoR(bonoPorcentaje)
		pepe.cambiarBonoP(bonoPresentismoNormal)
		pepe.cambiarCantidadDeFaltas(1)
		assert.equals(23000, pepe.sueldo())
	}

	test "Test 2 Segunda parte sueldo pepe"{
		medioTiempo.categoriaBase(cadete)
		pepe.cambiarCategoria(medioTiempo)
		pepe.cambiarBonoR(bonoPorcentaje)
		pepe.cambiarBonoP(bonoPresentimoDemagogico)
		pepe.cambiarCantidadDeFaltas(1)
		roque.cambiarBonoR(bonoMontoFijo)
		ernesto.cambiarSueldoAlDe(pepe)
		ernesto.cambiarBonoP(bonoPresentismoAjuste)
		assert.equals(11500, pepe.sueldo())
		assert.equals(37800, roque.sueldo())
		assert.equals(10100, ernesto.sueldo())
	}


	
}